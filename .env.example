# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=isg_brain
POSTGRES_USER=isg
POSTGRES_PASSWORD=localdev

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Inference (swap provider here)
INFERENCE_PROVIDER=claude
ADMIN_API_KEY=
# Optional explicit marker for local dev. Non-production stays open by default.
ALLOW_UNAUTHENTICATED_WRITE=true
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434
OPENAI_API_KEY=

# API Server
API_PORT=3100
BRAIN_API_URL=
BRAIN_TRANSPORT=

# Obsidian Local REST API
OBSIDIAN_API_URL=https://127.0.0.1:27124
OBSIDIAN_API_KEY=
OBSIDIAN_ALLOW_INSECURE_TLS=true

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_BOT_OFFSET_FILE=data/telegram-bot-offset.json

# RealNex CRM
REALNEX_API_TOKEN=
REALNEX_BASE_URL=https://sync.realnex.com
REALNEX_PAGE_SIZE=50
REALNEX_TIMEOUT_MS=30000

# Gmail / PropertyRadar alert ingestion
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ACCESS_TOKEN=
GMAIL_TOKEN_URL=https://oauth2.googleapis.com/token
GMAIL_REDIRECT_URI=http://127.0.0.1:8787/oauth/google/callback
GMAIL_PROPERTYRADAR_QUERY="Daily Digest Alert:"
GMAIL_PROPERTYRADAR_MAX_RESULTS=25

# PropertyRadar feed worker
PROPERTYRADAR_FEED_INTERVAL_MS=300000
PROPERTYRADAR_FEED_ITERATIONS=

# Omi / Hermes / Vermes channel ingress
OMI_WEBHOOK_SECRET=
OMI_DEFAULT_SOURCE=omi
HERMES_API_URL=
HERMES_API_KEY=
HERMES_WEBHOOK_SECRET=
HERMES_DEFAULT_SOURCE=hermes
VERMES_WEBHOOK_SECRET=
VERMES_DEFAULT_SOURCE=vermes
