{
  "name": "isg-second-brain",
  "version": "0.1.0",
  "private": true,
  "description": "Sullivan Link Brain backend for distressed commercial real estate intelligence, matching, and narrative knowledge workflows.",
  "main": "src/api/server.js",
  "bin": {
    "brain": "src/cli/brain.js"
  },
  "scripts": {
    "start": "node src/api/server.js",
    "migrate": "node scripts/admin/migrate.js",
    "seed": "node scripts/admin/seed-test-data.js",
    "local:up": "node scripts/admin/dev-runtime.js up",
    "local:up:seed": "node scripts/admin/dev-runtime.js up --seed",
    "local:up:pm2": "node scripts/admin/dev-runtime.js up --seed --pm2",
    "local:check": "node scripts/admin/dev-runtime.js check",
    "local:down": "node scripts/admin/dev-runtime.js down",
    "test": "node --test --test-concurrency=1",
    "test:unit": "node --test --test-concurrency=1 tests/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.js",
    "brain": "node src/cli/brain.js",
    "match": "node scripts/ops/run-matching.js",
    "telegram:bot": "node scripts/ops/run-telegram-bot.js",
    "telegram:probe": "node scripts/ops/telegram-probe.js",
    "propertyradar:feed": "node scripts/ops/run-propertyradar-feed.js",
    "wiki:maintain": "node scripts/ops/run-wiki-maintenance.js",
    "obsidian:publish": "node scripts/ops/publish-obsidian-note.js",
    "propertyradar:sync": "node scripts/imports/sync-propertyradar-alerts.js",
    "gmail:auth": "node scripts/admin/auth-gmail-pkce.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@chroma-core/default-embed": "^0.1.9",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chromadb": "^3.4.2",
    "csv-parser": "^3.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.1.1",
    "pg": "^8.13.1",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  }
}
